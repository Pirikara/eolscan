{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eolscan:schema:2:common",
  "$defs": {
    "general_eol_review": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "product_slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "package_purl": {
          "type": "string",
          "pattern": "^pkg:(gem|npm|pypi|maven|golang|cargo|nuget)/[^@?#\\s]+$"
        },
        "matched_cycle": {
          "type": "string",
          "minLength": 1
        },
        "support_scope": {
          "const": "upstream_security"
        },
        "evidence_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#@]+(?:[/?#]|$)"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "valid_until": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "id",
        "product_slug",
        "package_purl",
        "matched_cycle",
        "support_scope",
        "evidence_url",
        "reviewed_at",
        "valid_until"
      ],
      "additionalProperties": false
    },
    "version_assertion": {
      "type": "object",
      "properties": {
        "package_purl": {
          "type": "string",
          "pattern": "^pkg:(gem|npm|pypi|maven|golang|cargo|nuget)/[^@?#\\s]+@[^@?#\\s]+(?:\\?[^#\\s]+)?(?:#[^\\s]+)?$"
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#@]+(?:[/?#]|$)"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "valid_until": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "package_purl",
        "published_at",
        "source_url",
        "reviewed_at",
        "valid_until"
      ],
      "additionalProperties": false
    },
    "version_verification": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "NOT_FOUND_IN_INDEX",
            "UNVERIFIED",
            "NOT_RELEASED_AS_OF",
            "NOT_APPLICABLE"
          ]
        },
        "provider_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^/?#@]+(?:[/?#]|$)"
            },
            {
              "type": "null"
            }
          ]
        },
        "checked_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "provider_id",
        "source_url",
        "checked_at",
        "published_at",
        "reason_code"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "VERIFIED"
              }
            }
          },
          "then": {
            "properties": {
              "provider_id": {
                "type": "string",
                "minLength": 1
              },
              "source_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^/?#@]+(?:[/?#]|$)"
              },
              "checked_at": {
                "type": "string",
                "format": "date-time"
              },
              "published_at": {
                "type": "string",
                "format": "date-time"
              },
              "reason_code": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "reason_code": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_RELEASED_AS_OF"
              }
            }
          },
          "then": {
            "properties": {
              "published_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "signal_evaluation": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "DEPRECATED",
            "ARCHIVED",
            "RETRACTED",
            "QUARANTINED",
            "STALE_RELEASE",
            "STALE_REPOSITORY"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "PRESENT",
            "ABSENT",
            "UNKNOWN"
          ]
        },
        "provider_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^/?#@]+(?:[/?#]|$)"
            },
            {
              "type": "null"
            }
          ]
        },
        "checked_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "status",
        "provider_id",
        "source_url",
        "checked_at",
        "reason_code"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNKNOWN"
              }
            }
          },
          "then": {
            "properties": {
              "reason_code": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "provider_id": {
                "type": "string",
                "minLength": 1
              },
              "source_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^/?#@]+(?:[/?#]|$)"
              },
              "checked_at": {
                "type": "string",
                "format": "date-time"
              },
              "reason_code": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "signal_evidence": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "DEPRECATED",
            "ARCHIVED",
            "RETRACTED",
            "QUARANTINED",
            "STALE_RELEASE",
            "STALE_REPOSITORY"
          ]
        },
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^/?#@]+(?:[/?#]|$)"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "provider_id",
        "source_url",
        "observed_at",
        "details"
      ],
      "additionalProperties": false
    },
    "lifecycle_evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "source_class": {
          "type": "string",
          "enum": [
            "OFFICIAL",
            "CURATED_DATABASE"
          ]
        },
        "claim": {
          "type": "string",
          "enum": [
            "UPSTREAM_SECURITY_WINDOW",
            "UPSTREAM_SECURITY_END",
            "GENERAL_EOL_END"
          ]
        },
        "package_purl": {
          "type": "string",
          "pattern": "^pkg:(gem|npm|pypi|maven|golang|cargo|nuget)/[^@?#\\s]+$"
        },
        "product_slug": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "matched_cycle": {
          "type": "string",
          "minLength": 1
        },
        "support_scope": {
          "type": "string",
          "enum": [
            "upstream_security",
            "general_eol"
          ]
        },
        "support_start_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "eol_effective_date": {
          "type": "string",
          "format": "date"
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#@]+(?:[/?#]|$)"
        },
        "source_field": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_updated_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_payload_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM"
          ]
        },
        "rule_id": {
          "type": "string",
          "pattern": "^R-[0-9]{3}$"
        },
        "general_eol_review": {
          "anyOf": [
            {
              "$ref": "urn:eolscan:schema:2:common#/$defs/general_eol_review"
            },
            {
              "type": "null"
            }
          ]
        },
        "superseded_by": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "supersession_source_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^/?#@]+(?:[/?#]|$)"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "provider_id",
        "source_class",
        "claim",
        "package_purl",
        "product_slug",
        "matched_cycle",
        "support_scope",
        "support_start_date",
        "eol_effective_date",
        "source_url",
        "source_field",
        "observed_at",
        "source_updated_at",
        "reviewed_at",
        "valid_until",
        "raw_payload_hash",
        "confidence",
        "rule_id",
        "general_eol_review",
        "superseded_by",
        "supersession_source_url"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "claim": {
                "const": "GENERAL_EOL_END"
              }
            }
          },
          "then": {
            "properties": {
              "source_class": {
                "const": "CURATED_DATABASE"
              },
              "confidence": {
                "const": "MEDIUM"
              },
              "support_scope": {
                "const": "general_eol"
              },
              "support_start_date": {
                "type": "null"
              },
              "product_slug": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "null"
              },
              "valid_until": {
                "type": "null"
              },
              "superseded_by": {
                "type": "null"
              },
              "supersession_source_url": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "source_class": {
                "const": "OFFICIAL"
              },
              "confidence": {
                "const": "HIGH"
              },
              "support_scope": {
                "const": "upstream_security"
              },
              "reviewed_at": {
                "type": "string",
                "format": "date"
              },
              "valid_until": {
                "type": "string",
                "format": "date"
              },
              "general_eol_review": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim": {
                "const": "UPSTREAM_SECURITY_WINDOW"
              }
            }
          },
          "then": {
            "properties": {
              "support_start_date": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "else": {
            "properties": {
              "support_start_date": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "superseded_by": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "supersession_source_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^/?#@]+(?:[/?#]|$)"
              }
            }
          },
          "else": {
            "properties": {
              "supersession_source_url": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "notice": {
      "type": "object",
      "properties": {
        "type": {
          "const": "EOL_SOON"
        },
        "days_remaining": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_id": {
          "const": "R-009"
        }
      },
      "required": [
        "type",
        "days_remaining",
        "evidence_id",
        "rule_id"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "provider_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "http_status": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            {
              "type": "null"
            }
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "provider_id",
        "http_status",
        "retryable",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
