{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eolscan:schema:2:policy-input",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "input": {
      "type": "object",
      "properties": {
        "include_component_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "include_metadata_component": {
          "type": "boolean"
        },
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_components": {
          "type": "integer",
          "minimum": 1
        },
        "max_json_depth": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "properties": {
        "official_catalog": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "path": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "endoflife_date": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "base_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^/?#@]+(?:[/?#]|$)"
            },
            "match_purl_exactly": {
              "const": true
            },
            "use_security_support_label": {
              "type": "boolean"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "deps_dev": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "base_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^/?#@]+(?:[/?#]|$)"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "npm": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "base_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^/?#@]+(?:[/?#]|$)"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "pypi": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "base_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^/?#@]+(?:[/?#]|$)"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "rubygems": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "base_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^/?#@]+(?:[/?#]|$)"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "version_verification": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "required"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "deps_dev",
              "official_catalog",
              "registries"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "signals": {
      "type": "object",
      "properties": {
        "deprecated": {
          "type": "boolean"
        },
        "stale_release_days": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "yanked": {
          "type": "boolean"
        },
        "archived": {
          "type": "boolean"
        },
        "quarantined": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "notices": {
      "type": "object",
      "properties": {
        "eol_soon_days": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "support_scope": {
          "const": "upstream_security"
        },
        "max_evidence_age_days": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "allowed_hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "requests_per_second": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1000
        },
        "burst": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "max_wait_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "host_limits": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "requests_per_second": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 1000
              },
              "burst": {
                "type": "integer",
                "minimum": 1,
                "maximum": 256
              }
            },
            "required": [
              "requests_per_second",
              "burst"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "cache": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "positive_ttl_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "negative_ttl_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ci": {
      "type": "object",
      "properties": {
        "fail_on_statuses": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "EOL",
              "UNKNOWN"
            ]
          },
          "uniqueItems": true
        },
        "min_confidence": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM"
          ]
        },
        "fail_on_signals": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "DEPRECATED",
              "ARCHIVED",
              "RETRACTED",
              "QUARANTINED",
              "STALE_RELEASE",
              "STALE_REPOSITORY",
              "YANKED"
            ]
          },
          "uniqueItems": true
        },
        "fail_on_incomplete_scan": {
          "type": "boolean"
        },
        "max_unknown_ratio": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "exceptions": {
      "type": "object",
      "properties": {
        "path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "include_unknown": {
          "type": "boolean"
        },
        "include_evidence": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version"
  ],
  "additionalProperties": false
}
